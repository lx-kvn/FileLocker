<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FileLocker.Core\FileLocker.Core.csproj" />
    <!-- 只依賴介面契約，不依賴部件本體（PasswordVault.Core.dll，遷出獨立成 PasswordVault repo，
         見 PasswordVault_獨立化_規劃.md）——密碼庫是可選配部件，編譯期完全不引用它，執行期才用
         AssemblyLoadContext 動態載入（見 PasswordLockerPluginLoader）。 -->
    <ProjectReference Include="..\FileLocker.PluginContracts\FileLocker.PluginContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\IBMPlexSansTC-Regular.ttf" />
    <Resource Include="Assets\Fonts\IBMPlexSansTC-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\IBMPlexSansTC-Bold.ttf" />
  </ItemGroup>

  <!-- `.lockfolder` 標記檔的圖示：獨立 .ico 檔（不是借用主程式圖示），需要跟著建置輸出、
       跟著 dotnet publish 一起打包，ShellExtensionRegistrar 註冊 DefaultIcon 時才找得到。 -->
  <ItemGroup>
    <Content Include="LockFolderMarker.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <!-- 專案名稱維持 FileLocker.App（跟其他 FileLocker.* 專案的命名慣例一致），但建置出來的
         執行檔改叫 FileLocker.exe——工作列/工作管理員顯示的檔名更貼近產品名稱，不用讓使用者
         看到內部的專案分層命名。ShellExtensionRegistrar／App.xaml.cs 裡對應的備援檔名字串、
         installer/filelocker_installer.json 的 main_exe 都要跟著改，見這幾處的說明。 -->
    <AssemblyName>FileLocker</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 系統匣圖示（TrayIconManager 用的 System.Windows.Forms.NotifyIcon）需要——WPF 沒有原生的
         托盤圖示 API，跟 WinForms 混用是幫 WPF 加系統匣圖示最標準的做法，比手刻 Shell_NotifyIcon
         P/Invoke 少很多程式碼跟維護風險，.NET 上 WPF/WinForms 可以在同一個專案共存。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- UseWindowsForms 會自動幫整個專案加一個隱含的 `using System.Windows.Forms;`，
       跟 UseWPF 的 `using System.Windows;` 撞名（Application、KeyEventArgs 兩邊都有同名型別）。
       只有 TrayIconManager.cs 真的需要 WinForms，那個檔案自己寫明確的 using 就好，
       不需要整個專案都隱含引用它。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    只有 Release 建置才需要打包前端靜態檔案——Debug 建置照舊連到 Vite 開發伺服器
    （見 MainWindow.xaml.cs 裡的 #if DEBUG 分支），不需要每次 Debug 建置都重跑一次
    npm run build，開發起來才不會變慢。

    這兩個 Target 依序執行：先在 FileLocker.Web 資料夾跑 npm run build 產生 dist/，
    再把 dist/ 底下所有檔案複製進這個專案的輸出目錄下的 webapp/ 資料夾——
    正式執行時 MainWindow 會用 SetVirtualHostNameToFolderMapping 指向這個 webapp 資料夾。
  -->
  <Target Name="BuildWebFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm run build" WorkingDirectory="..\FileLocker.Web" />
  </Target>

  <Target Name="CopyWebAppForRelease" AfterTargets="BuildWebFrontend" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <WebAppFiles Include="..\FileLocker.Web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppFiles)" DestinationFolder="$(OutDir)webapp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Shell Extension 是獨立的 C++ 專案，用 cl.exe 手動編譯（見規格文件第 5.2 節），不屬於這個
    .NET 建置圖，MSBuild 不會自動幫忙編譯它。這裡只負責「如果那邊已經手動編出 DLL了，
    就複製一份放到跟 FileLocker.App.exe 同一個資料夾」——ShellExtensionRegistrar 靠這個
    同資料夾的檔案才能自動完成登錄，不管 Debug 還是 Release 建置都需要這份複製。
    找不到來源 DLL（例如還沒手動編譯過）不會讓建置失敗，單純跳過這個步驟。
  -->
  <Target Name="CopyShellExtensionDll" AfterTargets="Build">
    <ItemGroup>
      <ShellExtensionDll Include="..\FileLocker.ShellExtension\FileLockerShellExtension.dll" Condition="Exists('..\FileLocker.ShellExtension\FileLockerShellExtension.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ShellExtensionDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(ShellExtensionDll)' != ''" />
  </Target>

  <!--
    dotnet publish 產生 publish/ 資料夾用的是自己一套「要發佈哪些檔案」的清單機制（ComputeFilesToPublish），
    不會自動把 CopyShellExtensionDll 在 Build 階段丟進 $(OutDir) 的檔案一起帶過去——這裡用 MSBuild
    標準做法（BeforeTargets="ComputeFilesToPublish" 塞 ResolvedFileToPublish 項目）讓它也進到
    publish 輸出，不然照安裝程式打包 publish 資料夾的話，Shell Extension DLL 會整個漏掉。
  -->
  <Target Name="AddShellExtensionDllToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="Exists('..\FileLocker.ShellExtension\FileLockerShellExtension.dll')">
    <ItemGroup>
      <ResolvedFileToPublish Include="..\FileLocker.ShellExtension\FileLockerShellExtension.dll">
        <RelativePath>FileLockerShellExtension.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    同樣的道理：CopyWebAppForRelease 在 Build 階段把 dist/ 複製進 $(OutDir)webapp/，dotnet publish
    一樣不會自動把它帶進 publish/ 資料夾——執行期 MainWindow 靠 SetVirtualHostNameToFolderMapping
    指向這個資料夾載入前端畫面，找不到就會跳出「找不到前端畫面檔案」的錯誤視窗。跟 Shell Extension
    DLL 同一招，直接從來源 dist/ 登記 ResolvedFileToPublish，RelativePath 保留 webapp/ 底下的
    原始資料夾結構（%(RecursiveDir)）。
  -->
  <Target Name="AddWebAppToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\FileLocker.Web\dist')">
    <ItemGroup>
      <WebAppFilesForPublish Include="..\FileLocker.Web\dist\**\*.*" />
      <ResolvedFileToPublish Include="@(WebAppFilesForPublish)">
        <RelativePath>webapp\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    CLI（FileLocker.Cli）跟 GUI 是各自獨立的建置產物，之前完全沒有被納入安裝內容，見規格文件
    第 21 節。這裡比照上面 webapp/ 的三段式做法：Build 階段先另外 dotnet build 出 CLI，複製到
    輸出目錄下的 cli/ 子資料夾，再讓 dotnet publish 也把這個子資料夾一起帶走。

    放獨立子資料夾、不是跟 GUI 混在同一層：CLI 自己有一份完整的相依 DLL（FileLocker.Core.dll
    等），跟 GUI 那份是分開建置出來的兩份拷貝，混在同一個資料夾容易撞名或載到錯的版本
    （.NET framework-dependent 部署靠同資料夾內的 DLL 探測）。獨立子資料夾也剛好搭配安裝程式
    新加的 path_target_exe 欄位——加入系統 PATH 的只有 cli/ 這一層，不會把 GUI 那堆 DLL
    所在的安裝根目錄整個暴露進使用者的 PATH。
  -->
  <!--
    -p:Version=$(Version) 讓 FileLocker.Cli.exe 的檔案版本號跟著這次發布的版本走，不是永遠
    停在 .NET SDK 預設的 1.0.0.0——這是獨立另開的 dotnet build 呼叫（Exec 直接開一個新的
    命令列行程），不會自動繼承外層 dotnet publish 指令當下的 -p: 參數，要另外顯式傳一次。
    $(Version) 沒有從外層傳入時（例如日常開發直接 dotnet build，沒有特地帶 -p:Version）
    會是 MSBuild 的預設值 1.0.0，等同沒改過的既有行為，不會因為這個改動而報錯。
  -->
  <Target Name="BuildCli" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="dotnet build ..\FileLocker.Cli\FileLocker.Cli.csproj -c Release -p:Version=$(Version)" />
  </Target>

  <Target Name="CopyCliForRelease" AfterTargets="BuildCli" Condition="'$(Configuration)' == 'Release'">
    <!--
      Exclude 排掉 Cli 自己輸出目錄裡可能存在的 publish\ 子資料夾——如果有人對 FileLocker.Cli
      單獨跑過 dotnet publish，它自己的 bin\Release\...\ 底下就會多一份 publish\ 子資料夾，
      這裡的 **\*.* 萬用字元不排除的話會把那份也一起遞迴掃進來，複製出巢狀重複的內容
      （cli\publish\... 裡面又是一份完整拷貝）。

      複製兩份：cli\ 之後會被下面的 TrimCliForGuiInstaller 就地瘦身，發布進 GUI 安裝檔；
      cli-standalone\ 保持完整不動，供 filelocker_cli_installer.json（CLI_setup）／CLI_zip
      使用。cli-standalone\ 刻意留在 $(OutDir) 底下、不透過 ResolvedFileToPublish 發布進
      publish\ 資料夾——filelocker_installer.json 的 app_dir 是整個 publish\ 目錄，如果
      cli-standalone\ 也在裡面，GUI 安裝檔又會把這 58MB 重新打包回去，白費瘦身的功夫。
    -->
    <ItemGroup>
      <CliFiles Include="..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0\**\*.*"
                Exclude="..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0\publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CliFiles)" DestinationFolder="$(OutDir)cli\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CliFiles)" DestinationFolder="$(OutDir)cli-standalone\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    cli/ 資料夾裡有一大塊（Microsoft.Windows.SDK.NET.dll＋runtimes/，約 57MB）跟外層 GUI
    資料夾位元組完全相同——GUI 跟 CLI 是同一次建置產出，沒有理由在同一顆 GUI 安裝檔裡重複
    打包兩份（見 FileLocker.Cli/BundleTrimming.cs 開頭的完整說明）。cli-standalone\ 是上面
    CopyCliForRelease 留的未瘦身備份，這裡只對 cli\ 本身動手。
  -->
  <Target Name="TrimCliForGuiInstaller" AfterTargets="CopyCliForRelease" Condition="'$(Configuration)' == 'Release'">
    <!-- 路徑結尾補上 "." 再收尾引號——$(OutDir) 本身帶結尾反斜線，直接接引號會被 Windows
         命令列參數解析規則吃掉、跟下一個字元黏在一起，是這類建置腳本常見的坑。 -->
    <Exec Command="&quot;..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0\FileLocker.Cli.exe&quot; --internal-trim-bundle &quot;$(OutDir)cli\.&quot; &quot;$(OutDir).&quot;" />
  </Target>

  <Target Name="AddCliToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0')">
    <!--
      這裡發布的是 $(OutDir)cli\ 已經被 TrimCliForGuiInstaller 瘦身過的內容，不是重新從
      FileLocker.Cli 自己的 bin\Release\ 原封不動抓一份。cli-standalone\（完整未瘦身）
      刻意不發布進 publish\，見 CopyCliForRelease 開頭的說明——filelocker_cli_installer.json
      的 app_dir／CLI_zip 直接指向 $(OutDir)cli-standalone\（bin\Release\...\ 底下），
      不是 publish\ 底下的路徑。
    -->
    <ItemGroup>
      <CliFilesForPublish Include="$(OutDir)cli\**\*.*" />
      <ResolvedFileToPublish Include="@(CliFilesForPublish)">
        <RelativePath>cli\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    FileLocker.UpdateRelauncher 是自我更新用的協助行程（見更新流程說明：靜默安裝要求
    FileLocker.exe 已經完全結束，FileLocker 沒辦法自己等自己的安裝跑完，需要這支獨立行程
    負責「等 FileLocker 結束 → 跑靜默安裝 → 依結果重啟 FileLocker」）。跟 CLI 那組 Target
    同一個三段式模式，但**不是**放進 cli/ 子資料夾——直接複製到 $(OutDir) 根目錄，因為
    MainWindow.HandleDownloadAndInstallUpdateRequestAsync 是用 AppContext.BaseDirectory
    直接找這支 exe。TargetFramework 是 net10.0（不含 -windows），跟 GUI/CLI 的
    net10.0-windows... 不同，路徑要分開寫。只在 Release 建置執行：ReadInstalledVersion()
    在 Debug 建置本來就會因為找不到 installer_config.json 回傳 null，更新檢查功能在 Debug
    下本來就是關閉的，不需要 Debug 建置也帶著這支協助行程。
  -->
  <Target Name="BuildUpdateRelauncher" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <!-- -p:Version=$(Version)，理由跟 BuildCli 那邊一致——獨立的 Exec 呼叫不會自動繼承外層
         dotnet publish 帶的版本號。 -->
    <Exec Command="dotnet build ..\FileLocker.UpdateRelauncher\FileLocker.UpdateRelauncher.csproj -c Release -p:Version=$(Version)" />
  </Target>

  <Target Name="CopyUpdateRelauncherForRelease" AfterTargets="BuildUpdateRelauncher" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <UpdateRelauncherFiles Include="..\FileLocker.UpdateRelauncher\bin\Release\net10.0\**\*.*"
                              Exclude="..\FileLocker.UpdateRelauncher\bin\Release\net10.0\publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdateRelauncherFiles)" DestinationFolder="$(OutDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddUpdateRelauncherToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\FileLocker.UpdateRelauncher\bin\Release\net10.0')">
    <ItemGroup>
      <UpdateRelauncherFilesForPublish Include="..\FileLocker.UpdateRelauncher\bin\Release\net10.0\**\*.*"
                                        Exclude="..\FileLocker.UpdateRelauncher\bin\Release\net10.0\publish\**\*.*" />
      <ResolvedFileToPublish Include="@(UpdateRelauncherFilesForPublish)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 擴充功能 manifest.json 已經釘死 "key" 欄位，所以這個 ID 現在是固定值，不會因為
         重新載入未封裝項目而改變——隨 Native Host 一起複製到 plugins/PasswordLocker/，
         PasswordLockerNativeHostRegistrar 才找得到、不用使用者每次手動貼 ID。
         見 src/FileLocker.Extension/README.md。 -->
    <None Include="extension-id.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

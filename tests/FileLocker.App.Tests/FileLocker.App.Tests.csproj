<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 只需要 PasswordLockerNativePipeServer 這個純轉接層的攻擊面（見
       FileLocker_密碼庫_功能規劃.md 第 5 節），跟 FileLocker.App 其餘的 WPF 視窗／WebView2
       宿主邏輯無關——直接引用整個 FileLocker.App 專案（不是把 pipe server 抽成獨立專案），
       因為它本來就跟 App 的啟動流程（App.xaml.cs 建構 PasswordLockerNativePipeServer 的
       委派）綁在一起，抽成獨立專案反而會製造一個平常用不到的額外組件邊界。測試專案本身
       不是 WPF 應用程式（沒有 UseWPF、沒有自己的 App.xaml），只是把 FileLocker.App 的組件
       當函式庫引用，Main/App 進入點用不到，不影響測試主機執行。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FileLocker.App\FileLocker.App.csproj" />
    <ProjectReference Include="..\..\src\FileLocker.PasswordLocker\FileLocker.PasswordLocker.csproj" />
    <ProjectReference Include="..\..\src\FileLocker.PluginContracts\FileLocker.PluginContracts.csproj" />
  </ItemGroup>

</Project>

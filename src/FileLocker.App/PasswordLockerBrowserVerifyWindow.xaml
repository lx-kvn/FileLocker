<Window x:Class="FileLocker.App.PasswordLockerBrowserVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileLocker" Width="400" SizeToContent="Height" MinHeight="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="./Assets/Fonts/#IBM Plex Sans TC, Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei"
        Background="{DynamicResource SurfaceBrush}"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--
        瀏覽器擴充功能觸發密碼庫驗證時彈出的獨立小視窗——技術結構跟視覺樣式直接比照
        PasswordPromptWindow（雙擊 .locked 檔案跳出的那個，見該檔案開頭大段說明：無邊框、
        DWM 圓角、DragMove 拖曳、不設 Topmost 避免擋住 Windows Hello 對話框），這裡不重複
        抄一次理由。這個視窗一開啟就顯示（不像早期版本先靜默試一次 Passkey、失敗才叫出視窗）：
        有設定 Passkey 就在 Loaded 時自動觸發一次驗證（跟 PasswordPromptWindow 同一套互動
        模式），驗證期間密碼欄位鎖住（見 SetBusyState），Passkey 沒完成才退回密碼輸入、
        保留「重試 Passkey」按鈕。這個視窗本身就是 Windows Hello 前景固定手法要用的
        ownerWindowHandle——之前另外準備一個隱形的 owner 視窗，這個視窗要嘛完全不出現
        （Passkey 直接成功）、要嘛在密碼輸入這一步才姍姍來遲，隱形視窗跟這個視窗的生命週期
        脫節，驗證結束後隱形視窗還會賴著不消失；改成這個視窗從一開始就是唯一、真正被使用者
        看得到的前景視窗，不需要另外的隱形視窗，生命週期也單純很多（開啟到關閉就是這個視窗
        自己的全部生命週期）。

        刻意不透過 WebView2／MainWindow：使用者要的是「點瀏覽器裡的帳號、跳出驗證，不要
        把整個 FileLocker 主視窗叫出來」，MainWindow 還要等 WebView2 非同步初始化完成，
        對這種「就是要驗證一次」的情境來說太重、也太顯眼。
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#E1E4EA" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CDD6" />
        <SolidColorBrush x:Key="TextBrush" Color="#1B1E24" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#454A54" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B707A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A8770F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B14328" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D4F" />
        <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#F1F2F5" />

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <!-- 垂直內距之前是 14——那時候範本還沒有把 Padding 接上去（見下面 Border 的
                 Padding="{TemplateBinding Padding}"），沒有實際效果，MinHeight=44 就是
                 按鈕的實際高度。接上去之後 14 的垂直內距會把按鈕撐到明顯比 44 高，把下面
                 「重試 Passkey」那顆擠到跟這排按鈕太近——改成 8，讓 MinHeight=44 繼續是
                 主要決定高度的來源，內距只負責留水平呼吸空間。 -->
            <Setter Property="Padding" Value="26,8" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>

        <Style x:Key="TertiaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TrafficLightCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#FF5F57" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
                            <TextBlock x:Name="Glyph" Text="&#x2715;" FontSize="8" FontWeight="Bold"
                                       Foreground="#7A1300" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="FlatPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- 密碼遮罩用的圓點字元實際渲染高度比一般文字高，10,6 的垂直內距在 42px 高度下
                 會讓圓點的上緣被裁掉——加高、把垂直內距縮小，留更多空間給圓點本身。 -->
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <DockPanel>
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="38" Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="CloseTrafficLight" Style="{StaticResource TrafficLightCloseStyle}" Click="CancelButton_Click" />
                    <TextBlock Text="FileLocker 密碼庫" Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold" FontFamily="./Assets/Fonts/#IBM Plex Sans TC SmBld, Segoe UI Semibold, Microsoft JhengHei UI, Microsoft JhengHei" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Grid>

            <Grid>
            <StackPanel x:Name="MainContentPanel" Margin="24">
                <TextBlock x:Name="DomainText" FontWeight="SemiBold" FontSize="18" FontFamily="./Assets/Fonts/#IBM Plex Sans TC SmBld, Segoe UI Semibold, Microsoft JhengHei UI, Microsoft JhengHei" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="HintText" Text="這個網站想使用密碼庫裡的帳號密碼，請先驗證身份。" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12.5" Margin="0,0,0,14" TextWrapping="Wrap" />

                <TextBlock x:Name="PasskeyStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock x:Name="PasswordFieldLabel" Text="密碼庫密碼" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource FlatPasswordBoxStyle}" PasswordChanged="PasswordInput_PasswordChanged" />

                <!-- 圖示幾何資料跟 PasswordPromptWindow 的 PasskeyButton 同一份（來源：
                     src/FileLocker.Web/src/assets/Passkey_Black.svg 轉成 WPF Path/Ellipse），
                     沿用既有轉換好的資料，不用重新轉一次。 -->
                <Button x:Name="PasskeyButton" Style="{StaticResource TertiaryButtonStyle}"
                        Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="PasskeyButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                            <Canvas Width="1024" Height="1024">
                                <Ellipse Canvas.Left="236.2792912208" Canvas.Top="139.5863291823" Width="352.9695694086" Height="352.9695694086" Fill="{DynamicResource TextBrush}" />
                                <Path Fill="{DynamicResource TextBrush}"
                                      Data="M110.2186602587,720.6385116275L110.2186602587,672.4359486213C110.2186602587,606.3392511239 199.9314866801,552.6771187943 310.4325288895,552.6771187943L433.641053828,552.6771187943C461.7584457338,552.6771187943 488.5298702544,556.1515622323 512.8197929735,562.4212240684C524.5679740922,580.4791992171 544.1058242963,596.2168573563 568.9589347037,608.1541196815L568.9589347037,720.6385116275L110.2186602587,720.6385116275Z">
                                    <Path.RenderTransform>
                                        <MatrixTransform Matrix="1.123457,0,0,1.878205,-8.203184,-489.363828" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path Fill="{DynamicResource TextBrush}"
                                      Data="M692.7149689691,610.8482651048C652.6766086316,590.6366669841 625.4258469535,550.8882986408 625.4258469535,505.2025252538C625.4258469535,439.0698445186 682.5275338265,385.3784983651 752.8607978991,385.3784983651C823.1940619716,385.3784983651 880.2957488447,439.0698445186 880.2957488447,505.2025252538C880.2957488447,556.1200761911 846.4462926282,599.6624963178 798.7700901927,617.0029118183L845.0536840502,658.9837969154L788.4805712202,710.2976459786L845.0536840502,761.6114950417L786.5305723054,814.6940632894L752.5688461295,846.6274595852L718.6071199536,814.6940632894L692.7149689691,791.0886722076L692.7149689691,610.8482651048ZM752.3818302766,435.0727208025C731.2137872207,435.0727208025 714.028021961,451.2320835463 714.028021961,471.1358865571C714.028021961,491.0396895679 731.2137872207,507.1990523117 752.3818302766,507.1990523117C773.5498733325,507.1990523117 790.7356385921,491.0396895679 790.7356385921,471.1358865571C790.7356385921,451.2320835463 773.5498733325,435.0727208025 752.3818302766,435.0727208025Z">
                                    <Path.RenderTransform>
                                        <MatrixTransform Matrix="1.083064,0,0,1.151857,-66.470696,-89.36536" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="重試 Passkey" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Border x:Name="VerifyButtonHost" Background="Transparent">
                        <Button x:Name="VerifyButton" Content="驗證" Style="{StaticResource PrimaryButtonStyle}" Click="VerifyButton_Click" IsDefault="True" IsEnabled="False" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border x:Name="SuccessOverlay" Background="{DynamicResource SurfaceBrush}" Opacity="0" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="40" Height="40" Margin="0,0,0,10">
                        <Canvas Width="20" Height="20">
                            <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="17" Height="17"
                                     Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.6" />
                            <Path Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6.5,10.2 L8.7,12.4 L13.5,7.4" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="驗證成功" FontSize="15" FontWeight="SemiBold" FontFamily="./Assets/Fonts/#IBM Plex Sans TC SmBld, Segoe UI Semibold, Microsoft JhengHei UI, Microsoft JhengHei" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 只需要 PasswordLockerNativePipeServer 這個純轉接層的攻擊面，跟 FileLocker.App 其餘的
       WPF 視窗／WebView2 宿主邏輯無關——直接引用整個 FileLocker.App 專案（不是把 pipe server
       抽成獨立專案），因為它本來就跟 App 的啟動流程（App.xaml.cs 建構
       PasswordLockerNativePipeServer 的委派）綁在一起，抽成獨立專案反而會製造一個平常用不到
       的額外組件邊界。測試專案本身不是 WPF 應用程式（沒有 UseWPF、沒有自己的 App.xaml），
       只是把 FileLocker.App 的組件當函式庫引用，Main/App 進入點用不到，不影響測試主機執行。
       FileLocker.PasswordLocker 這個舊部件原始碼已經遷出獨立成 PasswordVault repo 並刪除
       （見 PasswordVault_獨立化_規劃.md 第 17 節），這裡原本多引用的那份 ProjectReference
       一併移除——測試檔案本身只用得到 FileLocker.PluginContracts 的型別。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FileLocker.App\FileLocker.App.csproj" />
    <ProjectReference Include="..\..\src\FileLocker.PluginContracts\FileLocker.PluginContracts.csproj" />
  </ItemGroup>

</Project>
